<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.4" snapToGrid="true">
  <code><![CDATA[
breed [households household]
breed [collectors collector]

globals [
  day
  total-waste
  average-blockage
  flood-risk-score
  risk-category
]

patches-own [
  waste-level
]

to setup
  clear-all

  set day 0
  set total-waste 0
  set average-blockage 0
  set flood-risk-score 0
  set risk-category "Low"

  ask patches [
    set waste-level 0
    set pcolor green
  ]

  create-households num-households [
    setxy random-xcor random-ycor
    set color blue
    set shape "person"
    set size 1.2
  ]

  create-collectors num-collectors [
    setxy random-xcor random-ycor
    set color white
    set shape "car"
    set size 1.5
  ]

  update-risk
  reset-ticks
end


to go
  set day day + 1

  ;; Households generate waste.
  ;; Higher awareness reduces litter entering drains.
  ask households [
    if random-float 100 > public-awareness [
      let target one-of patches in-radius 2
      
      if target != nobody [
        ask target [
          set waste-level
          waste-level + random-float waste-generation-rate
        ]
      ]
    ]
  ]

  ;; Collectors target patches that actually contain waste.
  if day mod collection-interval = 0 [
    if any? patches with [waste-level > 0] [
      ask collectors [
        if any? patches with [waste-level > 0] [
          move-to one-of patches with [waste-level > 0]
          
          ask patch-here [
            set waste-level
            max (list 0 (waste-level - 4))
          ]
        ]
      ]
    ]
  ]

  ;; Calculate accumulated waste and drainage blockage.
  update-risk

  ;; Colour patches according to waste accumulation.
  ask patches [
    ifelse waste-level < 3 [
      set pcolor green
    ] [
      ifelse waste-level < 6 [
        set pcolor yellow
      ] [
        set pcolor red
      ]
    ]
  ]

  tick
end

to update-risk
  set total-waste sum [waste-level] of patches

  ;; Scale waste accumulation into a 0-100
  ;; illustrative blockage indicator.
  set average-blockage
    mean [min (list 100 (waste-level * 30))] of patches

  ;; Combine rainfall exposure with the
  ;; interaction between rainfall and blockage.
  set flood-risk-score
    min (list 100
      (0.4 * rainfall-intensity
       + 0.6 * rainfall-intensity
         * average-blockage / 100))

  ;; Illustrative risk categories.
  ifelse flood-risk-score < 30 [
    set risk-category "Low"
  ] [
    ifelse flood-risk-score < 60 [
      set risk-category "Medium"
    ] [
      set risk-category "High"
    ]
  ]
end


to run-experiments
  random-seed 2026
  let rows []

  repeat 5000 [
    ;; Randomise scenario inputs
    set rainfall-intensity random 101
    set collection-interval (1 + random 7)
    set public-awareness random 101
    set waste-generation-rate (1 + random-float 9)
    set num-households (10 + random 91)
    set num-collectors (1 + random 10)

    ;; Initialise the scenario
    setup

    ;; Simulate 30 days
    repeat 30 [
      go
    ]

    ;; Record inputs and final outcomes
    set rows lput
      (word
        rainfall-intensity ","
        collection-interval ","
        public-awareness ","
        waste-generation-rate ","
        num-households ","
        num-collectors ","
        average-blockage ","
        total-waste ","
        flood-risk-score ","
        risk-category)
      rows
  ]

  ;; Export the CSV
  if file-exists? "waste_risk_dataset.csv" [
    file-delete "waste_risk_dataset.csv"
  ]

  file-open "waste_risk_dataset.csv"

  file-print
    "rainfall_intensity,collection_interval,public_awareness,waste_generation_rate,num_households,num_collectors,average_blockage,total_waste,flood_risk_score,risk_category"

  foreach rows [ row ->
    file-print row
  ]

  file-close

  print "5000 scenarios exported to waste_risk_dataset.csv"
end]]></code>
  <widgets>
    <view x="368" wrappingAllowedX="true" y="10" frameRate="30.0" minPycor="-16" height="434" showTickCounter="true" patchSize="13.0" fontSize="10" wrappingAllowedY="true" width="434" tickCounterLabel="ticks" maxPycor="16" updateMode="0" maxPxcor="16" minPxcor="-16"></view>
    <slider x="80" step="1" y="20" max="100" width="250" display="rainfall-intensity" height="50" min="0" direction="Horizontal" default="100.0" variable="rainfall-intensity"></slider>
    <slider x="80" step="1" y="85" max="7" width="250" display="collection-interval" height="50" min="1" direction="Horizontal" default="7.0" variable="collection-interval"></slider>
    <slider x="80" step="1" y="145" max="100" width="250" display="public-awareness" height="50" min="0" direction="Horizontal" default="9.0" variable="public-awareness"></slider>
    <slider x="80" step="0.5" y="210" max="10" width="250" display="waste-generation-rate" height="50" min="0" direction="Horizontal" default="10.0" variable="waste-generation-rate"></slider>
    <monitor x="475" precision="17" y="460" height="60" fontSize="11" width="100" display="Drain blockage">average-blockage</monitor>
    <monitor x="365" precision="17" y="460" height="60" fontSize="11" width="100" display="Total waste">total-waste</monitor>
    <monitor x="585" precision="17" y="460" height="60" fontSize="11" width="100" display="Flood risk">flood-risk-score</monitor>
    <slider x="80" step="1" y="275" max="100" width="250" display="num-households" height="50" min="10" direction="Horizontal" default="77.0" variable="num-households"></slider>
    <slider x="80" step="1" y="340" max="10" width="250" display="num-collectors" height="50" min="1" direction="Horizontal" default="1.0" variable="num-collectors"></slider>
    <button x="80" y="415" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55" display="Setup">setup</button>
    <button x="275" y="415" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55" display="Go">go</button>
    <button x="175" y="415" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="60" display="Dataset">run-experiments</button>
  </widgets>
  <info><![CDATA[# Smart Waste Management and Urban Flood-Risk Simulation in Sri Lanka

## 1. Overview

This project presents an agent-based simulation of waste accumulation, waste collection, and an illustrative urban flood-risk indicator in a hypothetical urban neighbourhood in Sri Lanka. The model is developed using NetLogo and explores how rainfall intensity, public awareness, waste generation, collection frequency, and the number of households and waste collectors influence simulated waste conditions and flood-risk categories.

The project also uses a dataset generated from the simulation to train a Random Forest machine-learning classifier. The classifier predicts the risk category associated with the simulated scenario inputs.

## 2. Project Objectives

* Simulate household waste generation and waste collection using autonomous agents.
* Visualise waste accumulation across the simulated environment.
* Explore how different environmental and waste-management parameters affect the simulated flood-risk score.
* Generate a dataset of 5,000 simulated scenarios for machine-learning experiments.
* Train and evaluate a Random Forest classifier to predict Low, Medium, and High risk categories.
* Demonstrate how agent-based modelling and machine learning can be combined to investigate an urban environmental problem.

## 3. How the Model Works

### Agents

**Households:** Represent sources of waste generation. Each day, households may add waste to a randomly selected nearby patch. The probability of generating waste depends on the public-awareness setting.

**Collectors:** Represent waste-collection agents. At collection intervals, collectors move towards patches containing waste and remove a limited amount.

**Patches:** Represent locations within the hypothetical neighbourhood. Each patch stores a waste-level value and changes colour to indicate the amount of accumulated waste.

### Patch Colours

* Green: low waste accumulation.
* Yellow: moderate waste accumulation.
* Red: high waste accumulation.

These colours indicate local waste levels, not directly measured water depth or observed flooding.

## 4. Model Parameters

The model includes the following parameters:

* **Rainfall intensity:** Controls the rainfall input used in the simulated risk calculation.
* **Collection interval:** Determines how frequently waste collection occurs.
* **Public awareness:** Influences the probability of household waste generation.
* **Waste generation rate:** Controls the amount of waste potentially generated.
* **Number of households:** Sets the number of household agents.
* **Number of collectors:** Sets the number of waste-collection agents.

## 5. Flood-Risk Indicator

The model calculates total accumulated waste and a simulated average blockage index based on patch waste levels. It then combines rainfall intensity and the blockage index to calculate a flood-risk score between 0 and 100.

The model classifies scores below 30 as Low risk, scores from 30 to below 60 as Medium risk, and scores of 60 or above as High risk.

These calculations are simplified assumptions designed for educational simulation. They are not calibrated hydrological equations and should not be interpreted as validated predictions of actual flooding in Sri Lanka.

## 6. Running the Model

1. Open the model in NetLogo.
2. Adjust the available parameter sliders.
3. Click **Setup** to initialise the simulation.
4. Click **Go** to run the simulation.
5. Observe household agents, collector agents, patch colours, accumulated waste, blockage index, and flood-risk outputs.
6. Change the parameters and repeat the simulation to compare different scenarios.
7. Use the dataset-generation button to run the automated experiments and export the CSV dataset.

## 7. Dataset Generation

The experiment procedure generates 5,000 simulated scenarios. For each scenario, the model randomly samples the six input parameters, initialises the simulation, runs it for 30 days, and records the resulting indicators and risk category.

The exported dataset contains the following ten columns:

* rainfall_intensity
* collection_interval
* public_awareness
* waste_generation_rate
* num_households
* num_collectors
* average_blockage
* total_waste
* flood_risk_score
* risk_category

The generated dataset represents synthetic simulation results rather than observations collected from actual neighbourhoods.

## 8. Machine-Learning Component

A Random Forest classifier is trained using six scenario inputs: rainfall intensity, collection interval, public awareness, waste generation rate, number of households, and number of collectors.

The dataset is divided into training and testing sets using an 80:20 stratified split. The baseline model achieved 96.9% accuracy on the 1,000-scenario test set.

The baseline classification results were:

* Low-risk F1-score: 0.98
* Medium-risk F1-score: 0.96
* High-risk F1-score: 0.84
* High-risk recall: 0.72

The dataset contains fewer High-risk scenarios than Low- and Medium-risk scenarios, so High-risk performance requires particular attention. The reported metrics measure how well the classifier reproduces the simulation-generated labels on held-out simulated scenarios.

## 9. Assumptions and Limitations

* The neighbourhood is hypothetical and does not represent a geographically calibrated location.
* Household waste generation and collector behaviour are simplified.
* The model does not explicitly simulate drainage networks, road layouts, elevation, runoff, water depth, or actual flood propagation.
* The blockage index and risk thresholds are assumed for this educational prototype.
* The dataset is synthetically generated by the model.
* The machine-learning classifier learns patterns in the simulation's generated labels.
* The reported classification metrics do not establish predictive accuracy for real-world flood events.

Future improvements could incorporate observed rainfall and flood data, explicit drainage infrastructure, spatially realistic neighbourhood layouts, and validation against documented flood events.

## 10. Conclusion

This project demonstrates an integrated workflow combining agent-based modelling, synthetic dataset generation, and supervised machine learning. The NetLogo simulation enables exploration of how waste generation, collection settings, public awareness, and rainfall inputs affect a simplified flood-risk indicator. The Random Forest classifier demonstrates how simulation-generated scenarios can be used for classification experiments. The prototype provides a foundation for future research but requires real-world data and hydrological validation before it can be used for practical flood-risk assessment.

## 11. Project Information

**Project title:** Smart Waste Management and Urban Flood-Risk Simulation in Sri Lanka

**Course:** Complex Systems & Agent Technology

**Group members:** K.R.D.P.De Zoysa/ K.W.G.S.B.K.Kulasooriya/ R.V.S.C. Lenora

**Institution:** University of Sri Jayewardenepura

**Tools used:** NetLogo, Python, pandas, and scikit-learn

**Model version:** 1.0
]]></info>
